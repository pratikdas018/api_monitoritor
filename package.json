{
  "name": "api_monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker,scheduler \"npm:dev:web\" \"npm:dev:worker\" \"npm:dev:scheduler\"",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .next) { Remove-Item .next -Recurse -Force }; npm run dev\"",
    "dev:web": "next dev",
    "dev:worker": "tsx src/worker/monitorWorker.ts",
    "dev:scheduler": "tsx src/jobs/monitorJob.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/monitorWorker.ts",
    "scheduler": "tsx src/jobs/monitorJob.ts",
    "lint": "next lint",
    "redis:start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process -FilePath 'C:\\Program Files\\Memurai\\memurai.exe' -ArgumentList '--port 6379 --bind 127.0.0.1' -WindowStyle Hidden\"",
    "redis:ping": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'C:\\Program Files\\Memurai\\memurai-cli.exe' -h 127.0.0.1 -p 6379 ping\""
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bullmq": "^5.70.1",
    "firebase": "^12.10.0",
    "ioredis": "^5.9.3",
    "mongoose": "^9.2.2",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
